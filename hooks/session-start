#!/usr/bin/env bash
# SessionStart hook for dev-forge plugin

set -euo pipefail

# Parse explicit platform argument (--cursor / --claude / empty).
# Prefer the explicit flag because CURSOR_PLUGIN_ROOT / CLAUDE_PLUGIN_ROOT
# are only injected in plugin mode; env vars remain a fallback for direct
# invocations that were wired before explicit flags existed.
PLATFORM="${1:-}"

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-dev-forge content
using_dev_forge_content=$(cat "${PLUGIN_ROOT}/skills/using-dev-forge/SKILL.md" 2>&1 || echo "Error reading using-dev-forge skill")

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_dev_forge_escaped=$(escape_for_json "$using_dev_forge_content")
session_context="<EXTREMELY_IMPORTANT>\nYou have dev-forge.\n\n**Below is the full content of your 'dev-forge:using-dev-forge' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**\n\n${using_dev_forge_escaped}\n</EXTREMELY_IMPORTANT>"

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
# Platform detection: explicit --cursor/--claude argument wins, env-var
# detection (CURSOR_PLUGIN_ROOT / CLAUDE_PLUGIN_ROOT) is the fallback for
# invocations without an explicit flag.
if [ "$PLATFORM" = "--cursor" ] || [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor: additional_context (snake_case)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ "$PLATFORM" = "--claude" ] || { [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; }; then
  # Claude: hookSpecificOutput 嵌套
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # SDK 标准: 顶层 additionalContext
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
